# ==============================================================================
# India Finance Intelligence Terminal - Environment Configuration
# ==============================================================================

ENVIRONMENT=development
LOG_LEVEL=INFO

# Storage & Lakehouse Configuration
STORAGE_BACKEND=local
LAKEHOUSE_BASE_PATH=./data/lakehouse

# MinIO / S3 Configuration (Optional for Airflow / S3 Lakehouse)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
S3_RAW_BUCKET=lakehouse-raw
S3_STAGING_BUCKET=lakehouse-staging
S3_CURATED_BUCKET=lakehouse-curated

# DuckDB Warehouse Path
DUCKDB_PATH=./data/warehouse/curated.duckdb

# Alert Dispatcher (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
