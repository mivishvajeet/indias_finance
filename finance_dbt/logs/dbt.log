[0m17:35:15.616139 [debug] [Thread-4 (]: On model.finance_dbt.int_stock_daily_returns: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "finance_dbt", "target_name": "dev", "node_id": "model.finance_dbt.int_stock_daily_returns"} */

  
  create view "curated"."main_intermediate"."int_stock_daily_returns__dbt_tmp" as (
    

WITH base_prices AS (
    SELECT * FROM "curated"."main_staging"."stg_stocks"
),

lagged AS (
    SELECT
        stock_price_id,
        symbol,
        trade_date,
        open_price,
        high_price,
        low_price,
        close_price,
        adj_close_price,
        volume,
        is_split_adjusted,
        data_source,

        -- Previous Trading Session Close (Ordering strictly by trade_date per symbol)
        LAG(close_price, 1) OVER (
            PARTITION BY symbol 
            ORDER BY trade_date ASC
        ) AS prev_close_price

    FROM base_prices
),

returns_computed AS (
    SELECT
        stock_price_id,
        symbol,
        trade_date,
        open_price,
        high_price,
        low_price,
        close_price,
        adj_close_price,
        volume,
        is_split_adjusted,
        data_source,
        prev_close_price,

        -- Daily Percentage Return: (Close - Prev_Close) / Prev_Close
        CASE 
            WHEN prev_close_price IS NOT NULL AND prev_close_price > 0
            THEN ROUND((close_price - prev_close_price) / prev_close_price, 6)
            ELSE NULL 
        END AS daily_return_pct,

        -- Daily Intraday Volatility Range: (High - Low) / Close
        CASE 
            WHEN close_price > 0 
            THEN ROUND((high_price - low_price) / close_price, 6)
            ELSE 0.0 
        END AS intraday_range_pct

    FROM lagged
)

SELECT * FROM returns_computed
  );

[0m17:35:15.616369 [debug] [Thread-2 (]: Using duckdb connection "model.finance_dbt.int_stock_ema_macd"
[0m17:35:15.616532 [debug] [Thread-3 (]: SQL status: OK in 0.001 seconds
[0m17:35:15.616772 [debug] [Thread-2 (]: On model.finance_dbt.int_stock_ema_macd: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "finance_dbt", "target_name": "dev", "node_id": "model.finance_dbt.int_stock_ema_macd"} */

  
  create view "curated"."main_intermediate"."int_stock_ema_macd__dbt_tmp" as (
    

-- EMA (Exponential Moving Average) & MACD Indicator Model
-- In standard SQL without recursive CTEs, we compute weighted exponential decay approximations:
-- EMA_12 (alpha = 2/(12+1) = 0.1538)
-- EMA_26 (alpha = 2/(26+1) = 0.07407)
-- MACD Line = EMA_12 - EMA_26
-- Signal Line (9-day EMA of MACD Line)
-- Histogram = MACD Line - Signal Line

WITH raw_prices AS (
    SELECT 
        stock_price_id,
        symbol,
        trade_date,
        close_price
    FROM "curated"."main_staging"."stg_stocks"
),

rolling_windows AS (
    SELECT
        stock_price_id,
        symbol,
        trade_date,
        close_price,
        
        -- Moving Averages for short/long momentum proxies
        AVG(close_price) OVER (
            PARTITION BY symbol ORDER BY trade_date ASC 
            ROWS BETWEEN 11 PRECEDING AND CURRENT ROW
        ) AS ema_12_proxy,

        AVG(close_price) OVER (
            PARTITION BY symbol ORDER BY trade_date ASC 
            ROWS BETWEEN 25 PRECEDING AND CURRENT ROW
        ) AS ema_26_proxy,

        COUNT(close_price) OVER (
            PARTITION BY symbol ORDER BY trade_date ASC 
            ROWS BETWEEN 25 PRECEDING AND CURRENT ROW
        ) AS depth_count

    FROM raw_prices
),

macd_prelim AS (
    SELECT
        stock_price_id,
        symbol,
        trade_date,
        close_price,
        ROUND(ema_12_proxy, 2) AS ema_12,
        ROUND(ema_26_proxy, 2) AS ema_26,
        ROUND(ema_12_proxy - ema_26_proxy, 2) AS macd_line,
        depth_count
    FROM rolling_windows
),

macd_signal_calc AS (
    SELECT
        stock_price_id,
        symbol,
        trade_date,
        close_price,
        ema_12,
        ema_26,
        macd_line,
        
        -- 9-Period Signal Line
        AVG(macd_line) OVER (
            PARTITION BY symbol ORDER BY trade_date ASC 
            ROWS BETWEEN 8 PRECEDING AND CURRENT ROW
        ) AS macd_signal_proxy,

        COUNT(macd_line) OVER (
            PARTITION BY symbol ORDER BY trade_date ASC 
            ROWS BETWEEN 8 PRECEDING AND CURRENT ROW
        ) AS signal_depth_count

    FROM macd_prelim
)

SELECT
    stock_price_id,
    symbol,
    trade_date,
    ema_12,
    ema_26,
    macd_line,
    ROUND(macd_signal_proxy, 2) AS macd_signal_line,
    ROUND(macd_line - macd_signal_proxy, 2) AS macd_histogram
FROM macd_signal_calc
  );

