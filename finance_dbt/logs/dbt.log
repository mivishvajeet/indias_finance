    create  table
      "curated"."main_marts"."dim_security__dbt_tmp"
  
    
    as (
      

WITH raw_securities AS (
    SELECT * FROM "curated"."main"."nse_securities"
),

formatted AS (
    SELECT
        -- Primary Surrogate Key
        MD5(UPPER(TRIM(symbol))) AS security_id,
        UPPER(TRIM(symbol)) AS symbol,
        TRIM(name) AS company_name,
        UPPER(TRIM(isin)) AS isin,
        TRIM(sector) AS sector_name,
        TRIM(industry) AS industry_name,
        UPPER(TRIM(security_type)) AS security_type,
        'INR' AS currency_code,
        'NSE' AS exchange_code
    FROM raw_securities
)

SELECT * FROM formatted
    );
    
  
[0m17:11:31.690390 [debug] [Thread-1 (]: Using duckdb connection "model.finance_dbt.dim_date"
[0m17:11:31.690582 [debug] [Thread-4 (]: On model.finance_dbt.stg_stocks: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "finance_dbt", "target_name": "dev", "node_id": "model.finance_dbt.stg_stocks"} */

  
  create view "curated"."main_staging"."stg_stocks__dbt_tmp" as (
    

WITH source_data AS (
    SELECT * FROM "curated"."main"."stg_stocks_daily"
),

standardized AS (
    SELECT
        -- Surrogate Primary Key
        MD5(CONCAT(TRIM(symbol), '_', CAST(trade_date AS VARCHAR))) AS stock_price_id,
        
        -- Dimensions & Ticker normalization
        UPPER(TRIM(symbol)) AS symbol,
        CAST(trade_date AS DATE) AS trade_date,
        
        -- Numeric OHLCV metrics
        CAST(ROUND(open, 2) AS DOUBLE) AS open_price,
        CAST(ROUND(high, 2) AS DOUBLE) AS high_price,
        CAST(ROUND(low, 2) AS DOUBLE) AS low_price,
        CAST(ROUND(close, 2) AS DOUBLE) AS close_price,
        CAST(ROUND(adj_close, 2) AS DOUBLE) AS adj_close_price,
        CAST(volume AS BIGINT) AS volume,
        
        -- Lineage, Audit & Flags
        CAST(is_split_adjusted AS BOOLEAN) AS is_split_adjusted,
        TRIM(source) AS data_source,
        CAST(ingested_at AS TIMESTAMP) AS ingested_at_utc,
        TRIM(payload_hash) AS raw_payload_hash

    FROM source_data
    WHERE symbol IS NOT NULL 
      AND trade_date IS NOT NULL
      AND close IS NOT NULL
      AND close > 0
)

SELECT * FROM standardized
  );

[0m17:11:31.690776 [debug] [Thread-3 (]: SQL status: OK in 0.001 seconds
[0m17:11:31.691002 [debug] [Thread-1 (]: On model.finance_dbt.dim_date: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "finance_dbt", "target_name": "dev", "node_id": "model.finance_dbt.dim_date"} */

    

    create  table
      "curated"."main_marts"."dim_date__dbt_tmp"
  
    
    as (
      

WITH date_spine AS (
    -- Generates calendar dates for 2024, 2025, and 2026 using DuckDB generate_series
    SELECT 
        CAST(d AS DATE) AS calendar_date
    FROM generate_series(DATE '2024-01-01', DATE '2026-12-31', INTERVAL '1 day') AS t(d)
),

holidays AS (
    SELECT 
        CAST(holiday_date AS DATE) AS holiday_date,
        TRIM(description) AS holiday_description
    FROM "curated"."main"."nse_trading_holidays"
),

enriched_calendar AS (
    SELECT
        -- Surrogate Key (YYYYMMDD integer format for Kimball dimensional modeling)
        CAST(strftime(calendar_date, '%Y%m%d') AS INTEGER) AS date_id,
        calendar_date,
        
        -- Calendar breakdown
        EXTRACT(YEAR FROM calendar_date) AS calendar_year,
        EXTRACT(MONTH FROM calendar_date) AS calendar_month,
        strftime(calendar_date, '%B') AS month_name,
        EXTRACT(QUARTER FROM calendar_date) AS calendar_quarter,
        EXTRACT(WEEK FROM calendar_date) AS calendar_week,
        EXTRACT(DOW FROM calendar_date) AS day_of_week_num, -- 0=Sunday, 6=Saturday
        strftime(calendar_date, '%A') AS day_name,
        
        -- Indian Fiscal Year (April 1 to March 31)
        CASE 
            WHEN EXTRACT(MONTH FROM calendar_date) >= 4 
            THEN CONCAT('FY', CAST(EXTRACT(YEAR FROM calendar_date) + 1 AS VARCHAR))
            ELSE CONCAT('FY', CAST(EXTRACT(YEAR FROM calendar_date) AS VARCHAR))
        END AS indian_fiscal_year,

        -- Trading vs Non-Trading Day Logic
        CASE 
            WHEN EXTRACT(DOW FROM calendar_date) IN (0, 6) THEN TRUE 
            ELSE FALSE 
        END AS is_weekend,

        CASE 
            WHEN h.holiday_date IS NOT NULL THEN TRUE 
            ELSE FALSE 
        END AS is_holiday,

        COALESCE(h.holiday_description, 'None') AS holiday_description,

        -- Critical Exchange Session Flag
        CASE 
            WHEN EXTRACT(DOW FROM calendar_date) IN (0, 6) THEN FALSE
            WHEN h.holiday_date IS NOT NULL THEN FALSE
            ELSE TRUE
        END AS is_trading_day

    FROM date_spine d
    LEFT JOIN holidays h ON d.calendar_date = h.holiday_date
)

SELECT * FROM enriched_calendar
    );
    
  
