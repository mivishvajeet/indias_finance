[0m17:11:31.799983 [debug] [Thread-4 (]: On model.finance_dbt.fact_daily_prices: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "finance_dbt", "target_name": "dev", "node_id": "model.finance_dbt.fact_daily_prices"} */

    

    create  table
      "curated"."main_marts"."fact_daily_prices__dbt_tmp"
  
    
    as (
      

WITH technicals AS (
    SELECT * FROM "curated"."main_intermediate"."int_stock_technicals"
),

ema_macd AS (
    SELECT * FROM "curated"."main_intermediate"."int_stock_ema_macd"
),

securities AS (
    SELECT * FROM "curated"."main_marts"."dim_security"
),

calendar AS (
    SELECT * FROM "curated"."main_marts"."dim_date"
),

joined AS (
    SELECT
        -- Primary Key
        t.stock_price_id AS price_fact_id,

        -- Foreign Keys
        s.security_id,
        c.date_id,
        
        -- Business Keys & Degenerate Dimensions
        t.symbol,
        t.trade_date,
        
        -- OHLCV Core Metrics
        t.open_price,
        t.high_price,
        t.low_price,
        t.close_price,
        t.adj_close_price,
        t.volume,

        -- Returns & Basic Indicators
        t.prev_close_price,
        t.daily_return_pct,
        t.intraday_range_pct,
        t.sma_20,
        t.sma_50,
        t.sma_200,
        t.high_52w,
        t.low_52w,
        t.is_volume_spike,
        t.avg_prior_20_volume,

        -- Advanced Indicators (Bollinger Bands)
        t.bollinger_middle,
        t.bollinger_upper,
        t.bollinger_lower,
        t.bollinger_bandwidth,

        -- Momentum Oscillator (RSI)
        t.rsi_14,

        -- Trend Indicators (EMA & MACD)
        m.ema_12,
        m.ema_26,
        m.macd_line,
        m.macd_signal_line,
        m.macd_histogram,

        -- Metadata
        t.is_split_adjusted,
        t.data_source

    FROM technicals t
    INNER JOIN ema_macd m ON t.stock_price_id = m.stock_price_id
    INNER JOIN securities s ON t.symbol = s.symbol
    INNER JOIN calendar c ON t.trade_date = c.calendar_date
)

SELECT * FROM joined
    );
    
  
