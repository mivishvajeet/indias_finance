  create view "curated"."main_staging"."stg_macro__dbt_tmp" as (
    

WITH source_data AS (
    SELECT * FROM "curated"."main"."stg_macro_indicators"
),

standardized AS (
    SELECT
        -- Surrogate Primary Key
        MD5(CONCAT(TRIM(indicator_code), '_', CAST(trade_date AS VARCHAR))) AS macro_indicator_id,
        
        -- Business Keys
        UPPER(TRIM(indicator_code)) AS indicator_code,
        CAST(trade_date AS DATE) AS observation_date,
        
        -- Value & Measurement
        CAST(ROUND(value, 4) AS DOUBLE) AS indicator_value,
        LOWER(TRIM(frequency)) AS frequency,
        TRIM(unit) AS unit_of_measure,
        
        -- Audit
        TRIM(source) AS data_source,
        CAST(ingested_at AS TIMESTAMP) AS ingested_at_utc,
        TRIM(payload_hash) AS raw_payload_hash

    FROM source_data
    WHERE indicator_code IS NOT NULL 
      AND trade_date IS NOT NULL
      AND value IS NOT NULL
)

SELECT * FROM standardized
  );

[0m11:31:12.535102 [debug] [Thread-2 (]: On model.finance_dbt.stg_stocks: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "finance_dbt", "target_name": "dev", "node_id": "model.finance_dbt.stg_stocks"} */

  
  create view "curated"."main_staging"."stg_stocks__dbt_tmp" as (
    

WITH source_data AS (
    SELECT * FROM "curated"."main"."stg_stocks_daily"
),

standardized AS (
    SELECT
        -- Surrogate Primary Key
        MD5(CONCAT(TRIM(symbol), '_', CAST(trade_date AS VARCHAR))) AS stock_price_id,
        
        -- Dimensions & Ticker normalization
        UPPER(TRIM(symbol)) AS symbol,
        CAST(trade_date AS DATE) AS trade_date,
        
        -- Numeric OHLCV metrics
        CAST(ROUND(open, 2) AS DOUBLE) AS open_price,
        CAST(ROUND(high, 2) AS DOUBLE) AS high_price,
        CAST(ROUND(low, 2) AS DOUBLE) AS low_price,
        CAST(ROUND(close, 2) AS DOUBLE) AS close_price,
        CAST(ROUND(adj_close, 2) AS DOUBLE) AS adj_close_price,
        CAST(volume AS BIGINT) AS volume,
        
        -- Lineage, Audit & Flags
        CAST(is_split_adjusted AS BOOLEAN) AS is_split_adjusted,
        TRIM(source) AS data_source,
        CAST(ingested_at AS TIMESTAMP) AS ingested_at_utc,
        TRIM(payload_hash) AS raw_payload_hash

    FROM source_data
    WHERE symbol IS NOT NULL 
      AND trade_date IS NOT NULL
      AND close IS NOT NULL
      AND close > 0
)

SELECT * FROM standardized
  );

