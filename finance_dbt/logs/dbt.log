[0m11:37:29.778284 [debug] [Thread-3 (]: On model.finance_dbt.int_stock_daily_returns: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "finance_dbt", "target_name": "dev", "node_id": "model.finance_dbt.int_stock_daily_returns"} */

  
  create view "curated"."main_intermediate"."int_stock_daily_returns__dbt_tmp" as (
    

WITH base_prices AS (
    SELECT * FROM "curated"."main_staging"."stg_stocks"
),

lagged AS (
    SELECT
        stock_price_id,
        symbol,
        trade_date,
        open_price,
        high_price,
        low_price,
        close_price,
        adj_close_price,
        volume,
        is_split_adjusted,
        data_source,

        -- Previous Trading Session Close (Ordering strictly by trade_date per symbol)
        LAG(close_price, 1) OVER (
            PARTITION BY symbol 
            ORDER BY trade_date ASC
        ) AS prev_close_price

    FROM base_prices
),

returns_computed AS (
    SELECT
        stock_price_id,
        symbol,
        trade_date,
        open_price,
        high_price,
        low_price,
        close_price,
        adj_close_price,
        volume,
        is_split_adjusted,
        data_source,
        prev_close_price,

        -- Daily Percentage Return: (Close - Prev_Close) / Prev_Close
        CASE 
            WHEN prev_close_price IS NOT NULL AND prev_close_price > 0
            THEN ROUND((close_price - prev_close_price) / prev_close_price, 6)
            ELSE NULL 
        END AS daily_return_pct,

        -- Daily Intraday Volatility Range: (High - Low) / Close
        CASE 
            WHEN close_price > 0 
            THEN ROUND((high_price - low_price) / close_price, 6)
            ELSE 0.0 
        END AS intraday_range_pct

    FROM lagged
)

SELECT * FROM returns_computed
  );

