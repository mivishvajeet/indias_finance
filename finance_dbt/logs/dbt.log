        TRIM(sector) AS sector_name,
        TRIM(industry) AS industry_name,
        UPPER(TRIM(security_type)) AS security_type,
        'INR' AS currency_code,
        'NSE' AS exchange_code
    FROM raw_securities
)

SELECT * FROM formatted
    );
    
  
