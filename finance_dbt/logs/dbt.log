with source as (
    select * from "curated"."main"."stg_mf_nav"
),
renamed as (
    select
        md5(scheme_code || '_' || cast(nav_date as varchar)) as nav_price_id,
        cast(scheme_code as varchar) as scheme_code,
        trim(scheme_name) as scheme_name,
        cast(nav_date as date) as nav_date,
        cast(nav as double) as nav,
        trim(fund_family) as fund_family,
        trim(scheme_category) as scheme_category,
        trim(source) as source,
        cast(ingested_at as timestamp) as ingested_at
    from source
    where nav > 0
)
select * from renamed
  );

[0m17:35:15.460033 [debug] [Thread-3 (]: On model.finance_dbt.stg_macro: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "finance_dbt", "target_name": "dev", "node_id": "model.finance_dbt.stg_macro"} */

  
  create view "curated"."main_staging"."stg_macro__dbt_tmp" as (
    

WITH source_data AS (
    SELECT * FROM "curated"."main"."stg_macro_indicators"
),

standardized AS (
    SELECT
        -- Surrogate Primary Key
        MD5(CONCAT(TRIM(indicator_code), '_', CAST(trade_date AS VARCHAR))) AS macro_indicator_id,
        
        -- Business Keys
        UPPER(TRIM(indicator_code)) AS indicator_code,
        CAST(trade_date AS DATE) AS observation_date,
        
        -- Value & Measurement
        CAST(ROUND(value, 4) AS DOUBLE) AS indicator_value,
        LOWER(TRIM(frequency)) AS frequency,
        TRIM(unit) AS unit_of_measure,
        
        -- Audit
        TRIM(source) AS data_source,
        CAST(ingested_at AS TIMESTAMP) AS ingested_at_utc,
        TRIM(payload_hash) AS raw_payload_hash

    FROM source_data
    WHERE indicator_code IS NOT NULL 
      AND trade_date IS NOT NULL
      AND value IS NOT NULL
)

SELECT * FROM standardized
  );

